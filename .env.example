# Owner/superuser connection - used ONLY for migrations & db setup
DATABASE_URL_OWNER="postgresql://postgres:CHANGE_ME@localhost:5432/medcrm"
# Tenant-scoped app role (NOBYPASSRLS) - Row Level Security is ENFORCED
DATABASE_URL_APP="postgresql://crm_app:CHANGE_ME@localhost:5432/medcrm"
# Platform role (BYPASSRLS) - only super-admin routes and login lookup
DATABASE_URL_PLATFORM="postgresql://crm_platform:CHANGE_ME@localhost:5432/medcrm"

TEST_DATABASE_URL_OWNER="postgresql://postgres:CHANGE_ME@localhost:5432/medcrm_test"
TEST_DATABASE_URL_APP="postgresql://crm_app:CHANGE_ME@localhost:5432/medcrm_test"
TEST_DATABASE_URL_PLATFORM="postgresql://crm_platform:CHANGE_ME@localhost:5432/medcrm_test"

# Private upload folder (outside /public). Replace src/server/storage.ts with S3/R2 in production.
UPLOAD_DIR="./uploads"

# 32+ random chars, used to sign session JWTs
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# --- Phase 6: messaging ---
# 32 bytes (base64 or hex) used to encrypt WhatsApp tokens in the DB. If empty, derived from SESSION_SECRET.
DATA_ENCRYPTION_KEY=""
# Bearer token for /api/cron/messaging (call every 1–5 min from your scheduler). 16+ chars.
CRON_SECRET=""
# Or run reminders inside the Next.js server (single instance only):
MESSAGING_WORKER="0"
MESSAGING_INTERVAL_SEC="120"
WHATSAPP_GRAPH_VERSION="v21.0"
