{
  "name": "medcrm",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant CRM/ERP SaaS for medical & aesthetic clinics",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx scripts/db-setup.ts --reset && tsx prisma/seed.ts",
    "test": "tsx scripts/db-setup.ts --test && vitest run",
    "test:reset": "tsx scripts/db-setup.ts --test --reset",
    "test:sim": "tsx scripts/db-setup.ts --test && vitest run tests/simulation.test.ts",
    "test:sim3w": "tsx scripts/db-setup.ts --test && vitest run tests/simulation3w.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.2",
    "jose": "^5.9.6",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv": "^16.4.7",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
